{
  "name": "menu",
  "query": "?debug&kb&peace&res=0.45",
  "steps": [
    "waitFor 10000 window.__G",
    "key tap Enter", "wait 1200",
    "log softlock: set down far from the carrier with a wrecked rotor, then abandon it from the pause menu",
    "eval (()=>{ const c=__G.war.carrier, I=__G.ISLANDS.find(i=>i.name==='LOOKOUT')||__G.ISLANDS[5]; __G.H.reset(new __G.THREE.Vector3(I.x, __G.terrainH(I.x,I.z)+3, I.z), 0, true, 0); __G.D.hp.rotor=0.02; window.__l0=__G.G.lives; return I.name })()",
    "wait 800",
    "key tap Escape", "wait 300",
    "expect __G.G.state === 'paused' && document.getElementById('menu').classList.contains('on')",
    "shot 01-menu",
    "key tap ArrowDown", "key tap ArrowDown", "wait 100",
    "expect __G.menu.items[__G.menu.sel].id === 'respawn'",
    "key tap Enter", "wait 200",
    "expect __G.G.state === 'paused' && __G.menu.confirm === 'respawn'",
    "shot 02-confirm",
    "key tap Enter", "wait 600",
    "expect __G.G.state === 'play' && __G.G.lives === __l0 - 1 && __G.D.hp.rotor === 1",
    "expect __G.H.pos.distanceTo(__G.war.carrier.p) < 70",
    "wait 1500",
    "shot 03-on-carrier",
    "log stuck in a cave: respawn brings us back out",
    "eval (()=>{ const b=__G.BASES[1]; __G.H.reset(new __G.THREE.Vector3(b.x+0.3, b.h+14, b.z+0.3), 0, false, 1); __G.HI.setCollective(0.3); return b.name })()",
    "waitFor 15000 __G.G.mode==='thrust'",
    "wait 1000",
    "key tap KeyP", "wait 200",
    "expect __G.G.state === 'paused'",
    "eval (__G.menu.sel=2, __G.menuPick(), __G.menuPick(), __G.G.mode)",
    "expect __G.G.mode === 'zarch' && __G.G.state === 'play'",
    "wait 2500",
    "shot 04-out-of-cave",
    "log resume and P toggle",
    "key tap KeyP", "wait 100", "key tap KeyP", "wait 100",
    "expect __G.G.state === 'play'",
    "log COMMANDER: abandoning the last Huey with nothing else in reserve or out loses the war (the fleet is spent)",
    "eval (__G.fleet.types.forEach(t => __G.fleet.n[t.id] = 0), __G.m60C.stow(), __G.m113C.stow(), __G.pool.list.forEach(V => V.stow()), __G.openMenu(), __G.menu.sel=2, __G.menuPick(), __G.menuPick(), __G.G.over)",
    "waitFor 6000 __G.G.state === 'title'",
    "expect document.querySelector('#title h1').textContent === 'DEFEAT'",
    "shot 05-defeat"
  ]
}
