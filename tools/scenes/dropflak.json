    "wait 1200",
    "log land damaged right under enemy guns on ANVIL; the dropship has to fly into the flak",
    "eval (()=>{ __G.G.bench=true; const I=__G.ISLANDS.find(i=>i.name==='ANVIL'); const x=I.pad.x+14, z=I.pad.z; __G.H.reset(new __G.THREE.Vector3(x, __G.terrainH(x,z)+1.2, z), 0, true, 0); __G.D.hp.rotor=0.3; return [I.owner, __G.war.aliveAA(I)] })()",
    "wait 1000",
    "eval (__G.callLogistics(), 1)",
    "waitFor 180000 __G.drop.state && (__G.drop.state.plane.u.hp < 14 || __G.drop.state.jumpers.length > 0)",
    "waitFor 180000 __G.drop.state && (__G.drop.state.plane.u.dying || __G.drop.state.left === 0)",
    "eval ({hp:__G.drop.state.plane.u.hp, dying:!!__G.drop.state.plane.u.dying, left:__G.drop.state.left, j:__G.drop.state.jumpers.length})",
    "wait 1500",
    "shot 01-flak",
    "log second call: the dropship is shot down on the run, the stick bails out",
    "waitFor 180000 __G.G.rescue === null",
    "eval (__G.D.hp.rotor=0.3, __G.callLogistics(), 1)",
    "waitFor 30000 __G.drop.state && __G.drop.state.phase === 'run' && __G.drop.state.left === 3",
    "wait 1500",
    "eval (__G.war.damage(__G.drop.state.plane.u, 99, 2), __G.drop.state.plane.u.dying)",
    "waitFor 3000 __G.drop.state.left === 0",
    "expect __G.drop.state.left === 0 && __G.drop.state.jumpers.length === 3",
    "wait 1200",
    "shot 02-going-down",
    "waitFor 30000 __G.drop.state.plane.gone",
    "wait 1000",
    "shot 03-crashed",
    "waitFor 180000 !__G.drop.state || __G.drop.state.done",
    "eval __G.drop.state && __G.drop.state.jumpers.map(j=>j.state)"
  ]
